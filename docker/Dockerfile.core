FROM ubuntu:24.04 AS builder
RUN apt-get update && apt-get install -y cmake build-essential libzmq3-dev libflatbuffers-dev flatbuffers-compiler
WORKDIR /app

COPY . . 
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j$(nproc)

FROM ubuntu:24.04-runtime
RUN apt-get update && apt-get install -y libzmq5 libflatbuffers24 && rm -rf /var/lib/apt/lists/*
COPY  --from=builder /app/build/vanguard_core /usr/local/bin/face_core
ENTRYPOINT [ "face_core" ]